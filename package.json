{
  "name": "family-care-hub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:db": "vitest run tests/db",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom --name",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed/index.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "prepare": "husky"
  },
